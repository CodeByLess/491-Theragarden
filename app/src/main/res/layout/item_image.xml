<?xml version="1.0" encoding="utf-8"?>

<!--
    item_image.xml

    Layout for a single image item inside the Gallery RecyclerView.
    Used by GalleryAdapter to display each saved photo.
-->

<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imageItem"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="4dp"
    android:scaleType="centerCrop"
    android:background="#6E8F4F" />

    <!--
        scaleType="centerCrop" ensures the image fills the view
        while maintaining aspect ratio.

        Background color acts as a placeholder before image loads.
    -->
