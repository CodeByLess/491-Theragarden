<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_brown"
    tools:context=".ui.dashboard.DashboardFragment">

    <Button
        android:id="@+id/btnLinks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        android:text="Links to Resources"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Added by Lesley Del Cid:
         Mood tracker self-care activity button. -->
    <Button
        android:id="@+id/btnMood"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Mood"
        app:layout_constraintEnd_toStartOf="@id/btnSleep"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLinks" />

    <!-- Added by Lesley Del Cid:
         Sleep tracker self-care activity button. -->
    <Button
        android:id="@+id/btnSleep"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="Sleep"
        app:layout_constraintEnd_toStartOf="@id/btnHydration"
        app:layout_constraintStart_toEndOf="@id/btnMood"
        app:layout_constraintTop_toBottomOf="@id/btnLinks" />

    <!-- Added by Lesley Del Cid:
         Hydration tracker self-care activity button. -->
    <Button
        android:id="@+id/btnHydration"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Hydration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSleep"
        app:layout_constraintTop_toBottomOf="@id/btnLinks" />

    <!-- Added by Lesley Del Cid:
         Guided breathing exercise activity button. -->
    <Button
        android:id="@+id/btnBreathing"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Breathing"
        app:layout_constraintEnd_toStartOf="@id/btnStretches"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMood" />

    <!-- Added by Lesley Del Cid:
         Guided stretches self-care activity button. -->
    <Button
        android:id="@+id/btnStretches"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:text="Stretches"
        app:layout_constraintEnd_toStartOf="@id/btnAffirmations"
        app:layout_constraintStart_toEndOf="@id/btnBreathing"
        app:layout_constraintTop_toBottomOf="@id/btnSleep" />

    <!-- Added by Lesley Del Cid:
         Daily affirmations self-care activity button. -->
    <Button
        android:id="@+id/btnAffirmations"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="Affirmation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnStretches"
        app:layout_constraintTop_toBottomOf="@id/btnHydration" />

    <!-- Added by Lesley Del Cid:
         Relaxing music self-care activity button. -->
    <Button
        android:id="@+id/btnMusic"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Music"
        app:layout_constraintEnd_toStartOf="@id/btnDoodle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBreathing" />

    <!-- Added by Lesley Del Cid:
         Doodle self-care activity button. -->
    <Button
        android:id="@+id/btnDoodle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:text="Doodle"
        app:layout_constraintEnd_toStartOf="@id/btnPhoto"
        app:layout_constraintStart_toEndOf="@id/btnMusic"
        app:layout_constraintTop_toBottomOf="@id/btnStretches" />

    <!-- Added by Lesley Del Cid:
         Gratitude photo self-care activity button. -->
    <Button
        android:id="@+id/btnPhoto"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="Photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnDoodle"
        app:layout_constraintTop_toBottomOf="@id/btnAffirmations" />

    <!-- Added by Lesley Del Cid:
         Positive quote and affirmation activity button. -->
    <Button
        android:id="@+id/btnQuote"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Quote"
        app:layout_constraintEnd_toStartOf="@id/btnJournal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMusic" />

    <!-- Added by Lesley Del Cid:
         Journal self-care activity button. -->
    <Button
        android:id="@+id/btnJournal"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:text="Journal"
        app:layout_constraintEnd_toStartOf="@id/btnPuzzle"
        app:layout_constraintStart_toEndOf="@id/btnQuote"
        app:layout_constraintTop_toBottomOf="@id/btnDoodle" />

    <!-- Added by Nathan:
     Puzzle button opens the puzzle self-care activity. -->
    <Button
        android:id="@+id/btnPuzzle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:text="Puzzle"
        app:layout_constraintTop_toBottomOf="@id/btnPhoto"
        app:layout_constraintStart_toEndOf="@id/btnJournal"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnMoreSoon"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="more soon"
        app:layout_constraintTop_toBottomOf="@id/btnJournal"
        app:layout_constraintStart_toEndOf="@id/btnQuote"
        app:layout_constraintEnd_toStartOf="@id/btnPuzzle" />
    <TextView
        android:id="@+id/text_dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.758" />

</androidx.constraintlayout.widget.ConstraintLayout>