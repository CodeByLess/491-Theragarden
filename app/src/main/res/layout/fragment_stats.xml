<?xml version="1.0" encoding="utf-8"?>

<!-- Added by Lesley Del Cid:
     Stats page layout for Theragarden app.
     Includes streaks, custom calendar, selected-day details, weekly/monthly summaries,
     habit streak tracking, plant image previews, and mood statistics chart. -->

<!-- Scrollable container to ensure content fits on all screen sizes -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_brown"
    android:padding="16dp">

    <!-- Main vertical layout for stacking UI elements -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="220dp">

        <!-- Added by Lesley Del Cid:
             Main title for the Stats page. -->
        <TextView
            android:id="@+id/txtStatsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statistics"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood Statistics"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Line chart displaying mood trends over time -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/moodChart"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="20dp" />

        <!-- Container for mood statistics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/gray_green"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <!-- Latest mood entry -->
            <TextView
                android:id="@+id/tvLatestMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Latest: --"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <!-- Average mood value -->
            <TextView
                android:id="@+id/tvAverageMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Average: --"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <!-- Highest recorded mood -->
            <TextView
                android:id="@+id/tvHighestMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Highest: --"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <!-- Lowest recorded mood -->
            <TextView
                android:id="@+id/tvLowestMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lowest: --"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <!-- Total number of mood entries -->
            <TextView
                android:id="@+id/tvTotalEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entries: 0"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Message shown based on user mood trends -->
        <TextView
            android:id="@+id/tvSupportMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Button to navigate to self-care tools if needed -->
        <Button
            android:id="@+id/btnSelfCareHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to Self-Care Hub"
            android:textColor="@color/white"
            android:backgroundTint="@color/gray_green"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Status text for loading or error messages -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginBottom="18dp" />

        <!-- Added by Lesley Del Cid:
             Displays the user's overall day streak. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/gray_green"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/txtDayStreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Day streak: 0"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Added by Lesley Del Cid:
             Custom calendar card with month navigation, weekday labels,
             calendar grid, and legend indicators. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#F5EFE9"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Added by Lesley Del Cid:
                     Month navigation row allowing users to switch months. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/btnPreviousMonth"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#2B1B10"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMonthTitle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="April 2026"
                        android:textColor="#2B1B10"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnNextMonth"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#2B1B10"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Added by Lesley Del Cid:
                     Weekday labels aligned with calendar columns. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#2B1B10" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#2B1B10" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="#2B1B10" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textColor="#2B1B10" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="#2B1B10" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textColor="#2B1B10" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#2B1B10" android:textStyle="bold" />
                </LinearLayout>

                <!-- Added by Lesley Del Cid:
                     RecyclerView displaying each calendar day. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/calendarRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Added by Lesley Del Cid:
                     Legend indicating task completion and plant growth markers. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_task_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed a task"
                        android:textColor="#2B1B10"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_plant_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grew a plant"
                        android:textColor="#2B1B10"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Added by Lesley Del Cid:
             Displays selected day details and dynamically generated plant image rows. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/gray_green"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtSelectedDateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected Day"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSelectedDayDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tap a date to view details."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <!-- Added by Lesley Del Cid:
                     Vertical container that expands dynamically.
                     Each row will contain multiple plant images, max 3 per row. -->
                <LinearLayout
                    android:id="@+id/plantPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Added by Lesley Del Cid:
             Weekly summary card. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#F5EFE9"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/txtWeeklySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Weekly Summary&#10;• Tasks completed: 0&#10;• Plants grown: 0"
                android:textColor="#2B1B10"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Added by Lesley Del Cid:
             Monthly summary card. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#F5EFE9"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/txtMonthlySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Monthly Summary&#10;• Tasks completed: 0&#10;• Plants grown: 0"
                android:textColor="#2B1B10"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Added by Lesley Del Cid:
             Habit streak card. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/gray_green"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtHabitStreakTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Habit Streaks"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHabitStreaks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No habit streaks yet."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Added by Lesley Del Cid:
             Bottom spacer so the last card can scroll above the bottom navigation bar. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp" />

    </LinearLayout>

</ScrollView>