<?xml version="1.0" encoding="utf-8"?>
<!-- Added by Lesley Del Cid:
     One day cell for the custom Stats calendar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayCell"
    android:layout_width="48dp"
    android:layout_height="56dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Day number -->
    <TextView
        android:id="@+id/txtDayNumber"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#2B1B10"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Task dot -->
        <View
            android:id="@+id/taskDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_task_dot"
            android:visibility="gone" />

        <!-- Plant dot -->
        <View
            android:id="@+id/plantDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_plant_dot"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>