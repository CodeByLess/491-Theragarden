<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Seeds">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtSeedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seedpack Inventory"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Seed 1
         Additional selectable seed for the user's seed inventory. -->
    <Button
        android:id="@+id/btnSeed1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sunflower Seed"
        android:layout_marginTop="32dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtSeedTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Seed 2
         Additional selectable seed for the user's seed inventory. -->
    <Button
        android:id="@+id/btnSeed2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Strawberry Seed"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnSeed1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Seed 3
         Additional selectable seed for the user's seed inventory. -->
    <Button
        android:id="@+id/btnSeed3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lavender Seed"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnSeed2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Seed 4
         Additional selectable seed for the user's seed inventory. -->
    <Button
        android:id="@+id/btnSeed4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tulip Seed"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnSeed3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Seed 5
         Additional selectable seed for the user's seed inventory. -->
    <Button
        android:id="@+id/btnSeed5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cactus Seed"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnSeed4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Seed 6
         Additional selectable seed for the user's seed inventory. -->
    <Button
        android:id="@+id/btnSeed6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Monstera Seed"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnSeed5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>