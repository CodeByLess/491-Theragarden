<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dark_gray_brown"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Seeds">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtSeedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seedpack Inventory"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Added by Lesley Del Cid:
         ScrollView allows starter seeds and purchased shop seeds
         to fit on the screen without being cut off. -->
    <ScrollView
        android:id="@+id/seedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtSeedTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Added by Lesley Del Cid:
             Vertical seed inventory list.
             Buttons 1–6 are starter seeds.
             Buttons 7–10 are shop seeds from Paula's Seed Shop. -->
        <LinearLayout
            android:id="@+id/seedButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">

            <!-- Seed 1: Starter seed -->
            <Button
                android:id="@+id/btnSeed1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sunflower Seed"
                android:layout_marginTop="8dp" />

            <!-- Seed 2: Starter seed -->
            <Button
                android:id="@+id/btnSeed2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strawberry Seed"
                android:layout_marginTop="16dp" />

            <!-- Seed 3: Starter seed -->
            <Button
                android:id="@+id/btnSeed3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lavender Seed"
                android:layout_marginTop="16dp" />

            <!-- Seed 4: Starter seed -->
            <Button
                android:id="@+id/btnSeed4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tulip Seed"
                android:layout_marginTop="16dp" />

            <!-- Seed 5: Starter seed -->
            <Button
                android:id="@+id/btnSeed5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cactus Seed"
                android:layout_marginTop="16dp" />

            <!-- Seed 6: Starter seed -->
            <Button
                android:id="@+id/btnSeed6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monstera Seed"
                android:layout_marginTop="16dp" />

            <!-- Seed 7: Shop seed from Paula's Seed Shop -->
            <Button
                android:id="@+id/btnSeed7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bonsai Tree"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Seed 8: Shop seed from Paula's Seed Shop -->
            <Button
                android:id="@+id/btnSeed8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cherry Blossom"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Seed 9: Shop seed from Paula's Seed Shop -->
            <Button
                android:id="@+id/btnSeed9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Palm Tree"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Seed 10: Shop seed from Paula's Seed Shop -->
            <Button
                android:id="@+id/btnSeed10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Venus Flytrap"
                android:visibility="gone"
                android:layout_marginTop="16dp" />
            <!-- Seed 11: Spin Wheel seed -->
            <Button
                android:id="@+id/btnSeed11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trumpet Flower"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Seed 12: Spin Wheel seed -->
            <Button
                android:id="@+id/btnSeed12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blue Rose"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Seed 13: Spin Wheel seed -->
            <Button
                android:id="@+id/btnSeed13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crystal Lotus"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Seed 14: Spin Wheel seed -->
            <Button
                android:id="@+id/btnSeed14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rainbow Tulip"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>