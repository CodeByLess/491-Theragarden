<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2b1408"
    tools:context=".ui.home.HomeFragment">

    <!-- Added by Lesley Del Cid:
         TOP ROOM SCENE CONTAINER:
         This light section recreates the room/wall area from the prototype.
         It holds the profile button, plant image, progress meter,
         and Paula's time badge area on the right side. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topSceneContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#f5efe9"
        app:layout_constraintBottom_toTopOf="@id/floorStrip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.42"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:text="@string/profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--Displays Bloom Points (reward currency from tasks/blooms) -paula -->
        <TextView
            android:id="@+id/txtBloomPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="Bloom Points: 0"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnProfile" />

        <!-- Added by Paula / adjusted by Lesley:
             Time badge now fits inside the blue square placeholder area. -->
        <TextView
            android:id="@+id/tvTimeBadge"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="26dp"
            android:background="#4c79c9"
            android:gravity="center"
            android:text="GM"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Added by Lesley Del Cid:
             VERTICAL GROWTH METER BACKGROUND -->
        <FrameLayout
            android:id="@+id/plantMeterContainer"
            android:layout_width="14dp"
            android:layout_height="150dp"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="24dp"
            android:background="#d7d0c9"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/plantMeterFill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="#53b52f" />

            <View
                android:id="@+id/plantMeterTopCap"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_gravity="top"
                android:background="#6b2d12" />
        </FrameLayout>

        <!-- Current plant display -->
        <FrameLayout
            android:id="@+id/plantImageContainer"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginStart="34dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/plantMeterContainer">

            <ImageView
                android:id="@+id/imgPlantStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Plant stage image"
                android:scaleType="fitCenter"
                android:src="@drawable/dirt" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floor strip -->
    <View
        android:id="@+id/floorStrip"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#9f684d"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topSceneContainer" />

    <!-- Daily goals panel -->
    <LinearLayout
        android:id="@+id/dailyGoalsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/rounded_container"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/floorStrip">

        <TextView
            android:id="@+id/txtDailyGoalsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Goals"
            android:textAlignment="center"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChooseNewSeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Choose New Seed"
            android:visibility="gone" />

        <!-- Task input row -->
        <LinearLayout
            android:id="@+id/taskInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTask"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:hint="@string/new_task"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add" />

        </LinearLayout>

        <!-- ACTION BUTTONS ROW - Annette -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRegen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="🔄 Regen (1)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSwap"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="🔀 Swap (2)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnQuickTask"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="⚡ Quick (3)"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Added by Paula / adjusted by Lesley:
             Spin Wheel and Seed Shop buttons now share the same row. -->
        <LinearLayout
            android:id="@+id/rewardButtonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSpinWheel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9800"
                android:text="Spin Wheel"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnOpenShop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#4CAF50"
                android:text="Seed Shop"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Enlarged RecyclerView area -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/taskRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="30dp" />

    </LinearLayout>

    <!-- HIDDEN DEBUG VIEWS - kept so existing Kotlin IDs do not break -->
    <TextView
        android:id="@+id/text_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCompletedGoals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Goals completed: 0"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCompletedPlants"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Plants completed: 0"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCurrentPlant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Current plant: None"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtPlantStage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Stage: dirt"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- HIDDEN ORIGINAL HORIZONTAL PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/plantProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>