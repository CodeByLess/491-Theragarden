<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6D8C3">

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Profile"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#6A4FBF"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTimeBadge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="GM"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@android:drawable/btn_default"
        android:backgroundTint="#6A4FBF"
        android:elevation="4dp"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Displays Bloom Points (reward currency from tasks/blooms) -paula -->
    <TextView
        android:id="@+id/txtBloomPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bloom Points: 0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnProfile" />

    <!-- Added by Lesley Del Cid: GOAL TRACKER DISPLAY:
         Shows the total number of completed goals for the current user.
         This value is updated in real-time from Firestore using a snapshot listener
         in HomeFragment. -->
    <TextView
        android:id="@+id/txtCompletedGoals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Goals completed: 0"
        android:textAlignment="center"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_home" />

    <!-- Added by Lesley Del Cid: CURRENT PLANT DISPLAY:
         Displays the ID/name of the active seed the user is currently growing.
         If no plant is selected, this shows "Current plant: None".
         Value is updated dynamically from Firestore. -->
    <TextView
        android:id="@+id/txtCurrentPlant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Current plant: None"
        android:textAlignment="center"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCompletedGoals" />

    <!-- Added by Lesley Del Cid: PLANT PROGRESS BAR:
         Represents the growth progress of the current plant.
         Progress value (0–100) is updated from Firestore (plantProgress field).
         Max is set to 100 assuming percentage-based growth. -->
    <ProgressBar
        android:id="@+id/plantProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:max="100"
        android:progress="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCurrentPlant" />

    <!-- Added by Lesley Del Cid: CHOOSE NEW SEED BUTTON:
         Only becomes visible when plantCompleted == true.
         Allows the user to start a new plant cycle.
         Initially hidden (visibility="gone") until Firestore listener updates it. -->
    <Button
        android:id="@+id/btnChooseNewSeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Choose New Seed"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/plantProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etTask"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="New task"
        android:backgroundTint="#6A4FBF"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtBloomPoints"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnChooseNewSeed" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#6A4FBF"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/etTask"
        app:layout_constraintBottom_toBottomOf="@id/etTask"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--Opens Spin Wheel feature to unlock rare plants -paula -->
    <Button
        android:id="@+id/btnSpinWheel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Spin Wheel"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/etTask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnOpenShop" />

    <!-- Opens shop to purchase plants using Bloom Points -paula -->
    <Button
        android:id="@+id/btnOpenShop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Seed Shop"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#4CAF50"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/etTask"
        app:layout_constraintStart_toEndOf="@id/btnSpinWheel"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnSpinWheel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>