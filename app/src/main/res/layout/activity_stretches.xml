<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_stretches.xml
  - Layout for the "Stretches" Activity (guided stretch screen)
  - Uses ConstraintLayout as the root so we can anchor:
      * Back button at the top-left
      * A central "card" (greenBox) that holds the content
      * Next/Submit buttons positioned relative to the greenBox
  - The Activity code applies window insets padding to the root view with id "main"
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_brown"
    tools:context=".Stretches">

    <!-- BACK BUTTON:
         - Simple navigation: finishes the Activity and returns to the previous screen -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- NEXT BUTTON:
         - Navigates to the next guided stretch screen (Stretch2)
         - Constrained relative to the content card (greenBox) so it stays visually tied to it -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        android:text="Next"
        app:layout_constraintEnd_toEndOf="@id/greenBox"
        app:layout_constraintTop_toBottomOf="@id/greenBox" />

    <!-- SUBMIT BUTTON:
         - Logs completion of this stretch (increments completedGoals in Firestore)
         - Positioned to the left of Next, aligned to Next's bottom edge -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="156dp"
        android:text="Submit"
        app:layout_constraintBottom_toBottomOf="@id/btnNext"
        app:layout_constraintEnd_toStartOf="@id/btnNext" />

    <!-- greenBox (MaterialCardView):
         - The main content container (rounded "card" look)
         - Uses percent-based width/height so it scales across screen sizes
         - Holds the stretch title + instructions inside a vertical LinearLayout -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/greenBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/gray_green"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.90"
        app:layout_constraintHeight_percent="0.70">

        <!-- Content column inside the card:
             - Vertical layout for title and body text
             - Padding adds spacing between the text and the card edges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title text for the current stretch -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Neck Roll"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <!-- Instructions text:
                 - Multi-line string showing step-by-step guidance
                 - lineSpacingExtra improves readability
             -->
            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Sit or stand tall.
                \n• Slowly tilt your head toward your right shoulder.
                \n• Roll forward, then left, completing a slow circle.
                \n\nRepeat 3 times each direction.
                \nInhale as your head rises, exhale as it falls.
                \n\n\n\n\n                         Press submit if you are done
                \n\                                                 or
                \n                    click next for another guided stretch"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>